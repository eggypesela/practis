<%# Register a client (module 6 task 6.3, PRD §4.1 "Client register").
    Payment terms are the client's default days-to-due-date; they are a REQUIRED
    business term but the column itself stays nullable so a client can be
    registered before terms are agreed (see clients-service.js header). %>
<% if (typeof error !== 'undefined' && error) { %>
<div class="errb"><div class="errb-tx"><p><b>Not registered.</b> <%= error %></p></div></div>
<% } %>

<% const v = (k) => (typeof form !== 'undefined' && form && form[k] != null) ? form[k] : ''; %>
<% const bad = (k) => (typeof field !== 'undefined' && field === k) ? 'aria-invalid="true"' : ''; %>

<form method="post" action="/clients">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="card" style="max-width:720px">
  <div class="card-hd"><h2>Client registration</h2><span class="r">PRD §4.1 · client register</span></div>
  <div class="fbody">
    <label class="fld">Client code <span class="dim">unique, e.g. CL-2027</span>
      <input type="text" name="code" maxlength="40" required <%= bad('code') %>
             value="<%= v('code') %>" placeholder="CL-2027"></label>

    <label class="fld">Client name
      <input type="text" name="name" required <%= bad('name') %>
             value="<%= v('name') %>" placeholder="Who the client is"></label>

    <label class="fld">Industry <span class="dim">optional — set up by an Administrator</span>
      <select name="industry_id" <%= bad('industry_id') %>>
        <option value="">— not set —</option>
        <% (typeof industryTypes !== 'undefined' ? industryTypes : []).forEach(function(t){ %>
        <option value="<%= t.id %>" <%= String(v('industry_id')) === String(t.id) ? 'selected' : '' %>><%= t.name %></option>
        <% }) %>
      </select></label>

    <label class="fld">Payment terms <span class="dim">days — the client's default due-date offset</span>
      <input type="number" name="payment_terms_days" min="1" step="1" inputmode="numeric" <%= bad('payment_terms_days') %>
             value="<%= v('payment_terms_days') %>" placeholder="30"></label>

    <label class="fld">Correspondence person <span class="dim">optional — who you deal with</span>
      <input type="text" name="correspondence_person" maxlength="200"
             value="<%= v('correspondence_person') %>"></label>

    <label class="fld">Email <span class="dim">optional</span>
      <input type="email" name="email" maxlength="200" <%= bad('email') %> value="<%= v('email') %>"></label>

    <label class="fld">Phone <span class="dim">optional</span>
      <input type="text" name="phone" maxlength="50" value="<%= v('phone') %>"></label>

    <label class="fld">Address <span class="dim">optional</span>
      <textarea name="address" rows="2" maxlength="500"><%= v('address') %></textarea></label>

    <label class="fld">Description <span class="dim">optional</span>
      <textarea name="description" rows="2" maxlength="1000"><%= v('description') %></textarea></label>

    <div class="fnote"><svg><use href="#i-info"/></svg><span>Registration also starts the approval chain:
      the client is <b>not approved</b> until a Project Manager approves it. Payment terms can be filled in
      later if the contract is not signed yet.</span></div>

    <button class="btn pri wide" type="submit"><svg><use href="#i-plus"/></svg>Register client</button>
  </div>
</div>
</form>
<svg style="display:none" aria-hidden="true"><defs>
<symbol id="i-info" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm-2.6 2.4h1.2v12.1H9.5z"/></symbol>
</defs></svg>
