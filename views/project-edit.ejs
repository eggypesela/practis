<%# Edit a registered project (module 6 task 6.2).
    The CODE is shown read-only on purpose: it is the human key other rows and
    imports are recognised by, so it is set once at registration. Baselines are
    NOT set here either — that is Module 7, via a BCR. %>
<% if (typeof error !== 'undefined' && error) { %>
<div class="errb"><div class="errb-tx"><p><b>Not saved.</b> <%= error %></p></div></div>
<% } %>

<% const v = (k) => (typeof form !== 'undefined' && form && form[k] != null) ? form[k] : ''; %>
<% const bad = (k) => (typeof field !== 'undefined' && field === k) ? 'aria-invalid="true"' : ''; %>

<div class="card" style="max-width:720px">
  <div class="card-hd"><h2>Approval</h2>
    <span class="r"><%= (typeof state !== 'undefined' && state.isApproved) ? 'approved' : 'awaiting approval' %></span></div>
  <div class="tw"><table>
    <thead><tr><th>Step</th><th>Applies to</th><th>Status</th><th>By</th><th>When</th><th>Comment</th></tr></thead>
    <tbody>
      <% ((typeof state !== 'undefined' && state.rows) ? state.rows : []).forEach(function(a){ %>
      <tr>
        <td class="mono"><%= a.step %></td>
        <td><%= a.required_role || '—' %></td>
        <td><span class="chip <%= a.status === 'approved' ? 'ok' : (a.status === 'rejected' ? 'bd' : 'nt') %>"><%= a.status %></span></td>
        <td><%= a.actor_email || '—' %></td>
        <td class="mono"><%= a.acted_at || '—' %></td>
        <td><%= a.comment || '—' %></td>
      </tr>
      <% }) %>
    </tbody>
  </table></div>
  <div class="fnote"><svg><use href="#i-info"/></svg><span>Under the light approval chain only
    <b>pm_approve</b> is required for the record to count as approved; every other step is recorded
    so the full PRD chain can be switched on later without losing history.</span></div>
</div>

<form method="post" action="/projects/<%= project.id %>" style="margin-top:12px">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="card" style="max-width:720px">
  <div class="card-hd"><h2><%= project.code %></h2><span class="r">registration details</span></div>
  <div class="fbody">
    <label class="fld">Project code <span class="dim">set at registration and not editable</span>
      <input type="text" value="<%= project.code %>" readonly disabled></label>

    <label class="fld">Project name
      <input type="text" name="name" required <%= bad('name') %> value="<%= v('name') %>"></label>

    <label class="fld">Client <span class="dim">optional</span>
      <select name="client_id">
        <option value="">— not set —</option>
        <% (typeof clients !== 'undefined' ? clients : []).forEach(function(c){ %>
        <option value="<%= c.id %>" <%= String(v('client_id')) === String(c.id) ? 'selected' : '' %>><%= c.code %> — <%= c.name %></option>
        <% }) %>
      </select></label>

    <label class="fld">Industry <span class="dim">optional</span>
      <select name="industry_type">
        <option value="">— not set —</option>
        <% (typeof industryTypes !== 'undefined' ? industryTypes : []).forEach(function(t){ %>
        <option value="<%= t.name || t.code %>" <%= v('industry_type') === (t.name || t.code) ? 'selected' : '' %>><%= t.name || t.code %></option>
        <% }) %>
      </select></label>

    <label class="fld">Revenue recognition method <span class="dim">required</span>
      <select name="revenue_method" required <%= bad('revenue_method') %>>
        <% (revenueMethods || []).forEach(function(m){ %>
        <option value="<%= m %>" <%= v('revenue_method') === m ? 'selected' : '' %>><%= m %></option>
        <% }) %>
      </select></label>

    <label class="fld">Contract amount <span class="dim">whole rupiah</span>
      <input type="number" name="contract_amount" min="0" step="1" inputmode="numeric" <%= bad('contract_amount') %>
             value="<%= v('contract_amount') %>"></label>

    <label class="fld">Payment terms <span class="dim">days</span>
      <input type="number" name="payment_terms_days" min="1" step="1" inputmode="numeric" <%= bad('payment_terms_days') %>
             value="<%= v('payment_terms_days') %>"></label>

    <label class="fld">Start date
      <input type="date" name="start_date" value="<%= v('start_date') || '' %>"></label>

    <label class="fld">End date
      <input type="date" name="end_date" <%= bad('end_date') %> value="<%= v('end_date') || '' %>"></label>

    <label class="fld">Status
      <select name="status">
        <% ['active','on_hold','closed'].forEach(function(s){ %>
        <option value="<%= s %>" <%= v('status') === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select></label>

    <button class="btn pri wide" type="submit"><svg><use href="#i-check"/></svg>Save changes</button>
  </div>
</div>
</form>
<svg style="display:none" aria-hidden="true"><defs>
<symbol id="i-info" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm-2.6 2.4h1.2v12.1H9.5z"/></symbol>
</defs></svg>
