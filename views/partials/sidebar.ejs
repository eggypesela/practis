<symbol id="i-check" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M4 2h16a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm10.6 6.2-5 5-2.2-2.2-1.4 1.4 3.6 3.6 6.4-6.4Z"/></symbol>
<symbol id="i-cash" viewBox="0 0 24 24"><path d="M4 5h16v14H4zm2 2v10h12V7zm4 2h4a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2v-2a2 2 0 0 1 2-2zm0 2v2h4v-2z"/></symbol>
<symbol id="i-file" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M5 2h14v20H5Zm3 4v2h8V6Zm0 4v2h8v-2Zm0 4v2h5v-2Z"/></symbol>
<symbol id="i-in" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-1 3.5h2v6.5h3l-4 4.6L8 12h3Z"/></symbol>
<symbol id="i-users" viewBox="0 0 24 24"><path d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm-5 9v-1a5 5 0 0 1 5-5h5a5 5 0 0 1 5 5v1zm14.5-9a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm3 9v-1a4.5 4.5 0 0 0-2.6-4 4 4 0 0 1 1.2 1.4c.9.7 1.4 1.6 1.4 2.6v1z"/></symbol>
<symbol id="i-chev" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6-1.4-1.4L12 12.2 7.4 7.6z"/></symbol>
</defs></svg>