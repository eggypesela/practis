<aside class="sb">
  <%# Tolerant of missing locals so pages rendered outside the app routes
      (403 blocked request, 404) still render instead of throwing. %>
  <% const _active = (typeof active !== 'undefined') ? active : ''; %>
  <% const _proj = (typeof projectName !== 'undefined') ? projectName : 'No project'; %>
  <% const _untagged = (typeof untaggedCount !== 'undefined') ? untaggedCount : 0;
     // Module 7 part 7.6: the badge is passed per-request by the pages that know it, so the
     // partial does not query the database (a partial that reads the DB once per render is
     // how the sidebar starts disagreeing with the screen it links to).
     const _pendingBcr = (typeof pendingBcr !== 'undefined') ? pendingBcr : 0; %>
  <div class="brand">
    <div class="mark"><svg width="15" height="15"><use href="#i-book"/></svg></div>
    <div class="brand-txt"><b>PRACTIS</b><span>Cost Control</span></div>
  </div>
  <nav class="nav">
    <div class="grp caps">Portfolio</div>
    <a href="/" class="<%= _active === 'Dashboard' ? 'on' : '' %>"><svg><use href="#i-grid"/></svg><span class="lbl">Dashboard</span></a>
    <a href="/projects" class="<%= _active === 'Projects' ? 'on' : '' %>"><svg><use href="#i-folder"/></svg><span class="lbl">Projects</span></a>
    <a href="/clients" class="<%= _active === 'Clients' ? 'on' : '' %>"><svg><use href="#i-users"/></svg><span class="lbl">Clients</span></a>
    <a href="/suppliers" class="<%= _active === 'Suppliers' ? 'on' : '' %>"><svg><use href="#i-in"/></svg><span class="lbl">Suppliers</span></a>
    <%# "Reports" was a dead href="#" here until module 8 part 8.3 built the route it
        names. The link and the route land in the SAME commit, because MS6.8 asserts every
        sidebar href resolves — a link added ahead of its route would fail that test, which
        is exactly what that test is for. It points at the report INDEX, not at the aging
        report, so the module's later reports do not require re-pointing it.
        Who may open it is `canViewReceivable` (Finance + Cost Controller); the sidebar
        shows it to everyone because the sidebar is not a permission system — the route
        answers 403 with a reason. %>
    <a href="/reports" class="<%= ['Aging', 'Forecast', 'Variance'].includes(_active) ? 'on' : '' %>"><svg><use href="#i-chart"/></svg><span class="lbl">Reports</span></a>
    <%# Module 8 part 8.6: the Project Overview S-curve screen. It sits HERE rather than in the
        (still display:none) Project group with WBS/Budget, because it is the report a PM opens
        first and it belongs beside the other reports. The group is a visible heading, so this
        reads as "the reports, then this project's overview", not as a stray link. It is a READ:
        no capability gate, unlike the aging report above it — see the route's comment. %>
    <a href="/reports/project" class="<%= _active === 'Overview' ? 'on' : '' %>"><svg><use href="#i-chart"/></svg><span class="lbl">Project overview</span></a>
    <div class="pctx">
      <span class="pc-lbl caps">Project</span>
      <% const _list = (typeof projects !== 'undefined' && projects) ? projects : []; %>
      <% const _sel = (typeof project !== 'undefined' && project) ? project : null; %>
      <% if (_list.length > 1) { %>
      <%# Real switcher. This was a dead <button> until now: scope could only be
          changed by hand-typing ?project=N, and the list offers ONLY projects the
          server-side scope middleware says this user may open. %>
      <div class="pc-wrap">
        <button class="pc-btn" type="button" id="pc-btn" aria-haspopup="listbox" aria-expanded="false"><span class="pc-dot"></span><span class="pc-name"><%= _sel ? _sel.name : '—' %></span><svg class="pc-chev"><use href="#i-chev"/></svg></button>
        <div class="pc-menu" id="pc-menu" role="listbox" hidden>
          <% _list.forEach(function(p){ %>
          <a role="option" aria-selected="<%= _sel && p.id === _sel.id ? 'true' : 'false' %>" class="<%= _sel && p.id === _sel.id ? 'on' : '' %>" data-project="<%= p.id %>" href="/?project=<%= p.id %>"><span class="pc-dot"></span><span class="pc-name"><%= p.name %></span></a>
          <% }) %>
        </div>
      </div>
      <% } else { %>
      <button class="pc-btn" type="button" disabled><span class="pc-dot"></span><span class="pc-name"><%= _sel ? _sel.name : (_proj || '—') %></span><svg class="pc-chev"><use href="#i-chev"/></svg></button>
      <% } %>
    </div>
    <div class="grp caps">Setup</div>
    <%# NOT under Administration even though it looks administrative: Cost Controller
        and Finance must reach it to maintain the cost buckets and accounts they tag
        with, and the Administration group above is hidden from them entirely.
        The WBS/RBS lists inside are gated to Administrator by the route. %>
    <a href="/master" class="<%= _active === 'Master data' ? 'on' : '' %>"><svg><use href="#i-file"/></svg><span class="lbl">Master data</span></a>
    <div class="grp caps" style="display:none">Project</div>
    <%# Overview / CBS plan were dead href="#" links. Removed for the same reason
        as Reports above — their routes do not exist yet. Overview belongs to the
        reports module; CBS plan to module 7 part 7.4. Removed, not hidden, so the
        count of dead links stays at zero and a future test can assert it. %>
    <a href="/wbs" class="<%= _active === 'WBS' ? 'on' : '' %>"><svg><use href="#i-tree"/></svg><span class="lbl">WBS</span></a>
    <a href="/rbs" class="<%= _active === 'Resource plan' ? 'on' : '' %>"><svg><use href="#i-book"/></svg><span class="lbl">Resource plan</span></a>
    <a href="/cbs" class="<%= _active === 'Budget' ? 'on' : '' %>"><svg><use href="#i-chart"/></svg><span class="lbl">Budget</span></a>
    <%# Module 7 part 7.6. The plan called for "BCR register" under a Control group; the
        sidebar has Portfolio / Setup / Project / Administration, and a fifth group for one
        link would be noise. It sits with the rest of the project's planning screens, which
        is also where an operator looks for it after freezing a baseline. %>
    <a href="/bcr" class="<%= _active === 'Change requests' ? 'on' : '' %>"><svg><use href="#i-swap"/></svg><span class="lbl">Change requests</span><% if (typeof _pendingBcr !== 'undefined' && _pendingBcr) { %><span class="pill"><%= _pendingBcr %></span><% } %></a>
    <a href="/ledger" class="<%= _active === 'Ledger' ? 'on' : '' %>"><svg><use href="#i-book"/></svg><span class="lbl">Ledger</span></a>
    <a href="/import" class="<%= _active === 'Import' ? 'on' : '' %>"><svg><use href="#i-in"/></svg><span class="lbl">Import</span></a>
    <a href="/queue" class="<%= _active === 'Tagging queue' ? 'on' : '' %>"><svg><use href="#i-check"/></svg><span class="lbl">Tagging queue</span><% if (_untagged) { %><span class="pill"><%= _untagged %></span><% } %></a>
    <a href="/advances" class="<%= _active === 'Cash advances' ? 'on' : '' %>"><svg><use href="#i-cash"/></svg><span class="lbl">Cash advances</span></a>
    <a href="/expenses" class="<%= _active === 'Expense reports' ? 'on' : '' %>"><svg><use href="#i-file"/></svg><span class="lbl">Expense reports</span></a>
    <a href="/reconciliation" class="<%= _active === 'Reconciliation' ? 'on' : '' %>"><svg><use href="#i-check"/></svg><span class="lbl">Reconciliation</span></a>
    <%# "Revenue" was a dead href="#". Removed — the revenue module is not built.
        The tag was removed from the sidebar AND from the sidebar-contract test's
        expected list, where it was pinning a link that went nowhere. %>
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
    <div class="grp caps">Administration</div>
    <a href="/admin/users" class="<%= _active === 'Users' ? 'on' : '' %>"><svg><use href="#i-users"/></svg><span class="lbl">Users &amp; roles</span></a>
    <a href="/admin/teams" class="<%= _active === 'Teams' ? 'on' : '' %>"><svg><use href="#i-tree"/></svg><span class="lbl">Teams</span></a>
    <a href="/periods" class="<%= _active === 'Accounting periods' ? 'on' : '' %>"><svg><use href="#i-book"/></svg><span class="lbl">Accounting periods</span></a>
    <% } %>
  </nav>
  <div class="sb-foot">
    <div class="av"><%= (typeof initials !== 'undefined') ? initials : '?' %></div>
    <div class="who"><b><%= (typeof userName !== 'undefined') ? userName : 'Signed out' %></b><span><%= (typeof roleName !== 'undefined') ? roleName : '' %></span></div>
  </div>
</aside>
<svg style="display:none" aria-hidden="true"><defs>
<symbol id="i-grid" viewBox="0 0 24 24"><path d="M3 3h8v8H3zm10 0h8v8h-8zM3 13h8v8H3zm10 0h8v8h-8z"/></symbol>
<symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 5.5A1.5 1.5 0 0 1 4.5 4h4.2c.5 0 .8.2 1.1.5L11 6h8.5A1.5 1.5 0 0 1 21 7.5v11A1.5 1.5 0 0 1 19.5 20h-15A1.5 1.5 0 0 1 3 18.5z"/></symbol>
<symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 20h16v1.6H4zM6.5 12h2.6v6H6.5zm4.6-5h2.6v11h-2.6zm4.6 3h2.6v8h-2.6z"/></symbol>
<symbol id="i-home" viewBox="0 0 24 24"><path d="M12 3l9 8h-3v8h-4v-5h-4v5H6v-8H3z"/></symbol>
<symbol id="i-tree" viewBox="0 0 24 24"><path d="M3 3h6v4H3zm0 7h6v4H3zm0 7h6v4H3zm12-7h6v4h-6zM9.2 4.6h1.8v14.8H9.2zm1.8 6.7h4v1.8h-4z"/></symbol>
<symbol id="i-book" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M4 2h16a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm2 4v2h12V6Zm0 4v2h12v-2Zm0 4v2h8v-2Z"/></symbol>
<symbol id="i-check" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M4 2h16a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm10.6 6.2-5 5-2.2-2.2-1.4 1.4 3.6 3.6 6.4-6.4Z"/></symbol>
<symbol id="i-cash" viewBox="0 0 24 24"><path d="M4 5h16v14H4zm2 2v10h12V7zm4 2h4a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2v-2a2 2 0 0 1 2-2zm0 2v2h4v-2z"/></symbol>
<symbol id="i-file" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M5 2h14v20H5Zm3 4v2h8V6Zm0 4v2h8v-2Zm0 4v2h5v-2Z"/></symbol>
<symbol id="i-in" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-1 3.5h2v6.5h3l-4 4.6L8 12h3Z"/></symbol>
<symbol id="i-users" viewBox="0 0 24 24"><path d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm-5 9v-1a5 5 0 0 1 5-5h5a5 5 0 0 1 5 5v1zm14.5-9a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm3 9v-1a4.5 4.5 0 0 0-2.6-4 4 4 0 0 1 1.2 1.4c.9.7 1.4 1.6 1.4 2.6v1z"/></symbol>
<symbol id="i-chev" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6-1.4-1.4L12 12.2 7.4 7.6z"/></symbol>
<symbol id="i-swap" viewBox="0 0 24 24"><path d="M7.5 3 3.6 6.9l1.4 1.4 1.5-1.5V16h2V6.8l1.5 1.5 1.4-1.4zm9 18 3.9-3.9-1.4-1.4-1.5 1.5V8h-2v9.2l-1.5-1.5-1.4 1.4z"/></symbol>
</defs></svg>