<form method="post" action="/login" class="auth-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (typeof error !== 'undefined') { %><div class="errb"><div class="errb-tx"><p><%= error %></p></div></div><% } %>
  <h2>Sign in</h2>
  <p class="sub">PRACTIS cost control</p>
  <% const isLocked = typeof locked !== 'undefined' && locked; %>
  <label>Email<input type="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>" autofocus required <%= isLocked ? 'disabled' : '' %>></label>
  <label>Password<input type="password" name="password" required <%= isLocked ? 'disabled' : '' %>></label>
  <button class="btn pri" type="submit" <%= isLocked ? 'disabled' : '' %>>Sign in</button>
</form>