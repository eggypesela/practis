<%# Register a project (module 6 task 6.2, PRD §4.1 steps 1-6).
    A new project is created with NO numbers and NO baseline — the portfolio
    card says "not baselined" until Module 7 locks one. %>
<% if (typeof error !== 'undefined' && error) { %>
<div class="errb"><div class="errb-tx"><p><b>Not registered.</b> <%= error %></p></div></div>
<% } %>

<% const v = (k) => (typeof form !== 'undefined' && form && form[k] != null) ? form[k] : ''; %>
<% const bad = (k) => (typeof field !== 'undefined' && field === k) ? 'aria-invalid="true"' : ''; %>

<form method="post" action="/projects">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="card" style="max-width:720px">
  <div class="card-hd"><h2>Project registration</h2><span class="r">step 1 of the project lifecycle</span></div>
  <div class="fbody">
    <label class="fld">Project code <span class="dim">unique, e.g. JC-2027</span>
      <input type="text" name="code" maxlength="40" required <%= bad('code') %>
             value="<%= v('code') %>" placeholder="JC-2027"></label>

    <label class="fld">Project name
      <input type="text" name="name" required <%= bad('name') %>
             value="<%= v('name') %>" placeholder="What the project is called"></label>

    <label class="fld">Client <span class="dim">optional — the client register is a separate step</span>
      <select name="client_id">
        <option value="">— not set —</option>
        <% (typeof clients !== 'undefined' ? clients : []).forEach(function(c){ %>
        <option value="<%= c.id %>" <%= String(v('client_id')) === String(c.id) ? 'selected' : '' %>><%= c.code %> — <%= c.name %></option>
        <% }) %>
      </select></label>

    <label class="fld">Industry <span class="dim">optional — set up by an Administrator</span>
      <select name="industry_type">
        <option value="">— not set —</option>
        <% (typeof industryTypes !== 'undefined' ? industryTypes : []).forEach(function(t){ %>
        <option value="<%= t.name || t.code %>" <%= v('industry_type') === (t.name || t.code) ? 'selected' : '' %>><%= t.name || t.code %></option>
        <% }) %>
      </select></label>

    <label class="fld">Revenue recognition method <span class="dim">required (PRD §4.1 step 5)</span>
      <select name="revenue_method" required <%= bad('revenue_method') %>>
        <option value="">— choose one —</option>
        <% (revenueMethods || []).forEach(function(m){ %>
        <option value="<%= m %>" <%= v('revenue_method') === m ? 'selected' : '' %>><%= m %></option>
        <% }) %>
      </select></label>

    <label class="fld">Contract amount <span class="dim">whole rupiah — leave blank for now</span>
      <input type="number" name="contract_amount" min="0" step="1" inputmode="numeric" <%= bad('contract_amount') %>
             value="<%= v('contract_amount') %>" placeholder="0"></label>

    <label class="fld">Payment terms <span class="dim">days — drives the aging report due date (PRD §5.2)</span>
      <input type="number" name="payment_terms_days" min="1" step="1" inputmode="numeric" <%= bad('payment_terms_days') %>
             value="<%= v('payment_terms_days') %>" placeholder="30"></label>

    <label class="fld">Start date
      <input type="date" name="start_date" value="<%= v('start_date') %>"></label>

    <label class="fld">End date
      <input type="date" name="end_date" <%= bad('end_date') %> value="<%= v('end_date') %>"></label>

    <div class="fnote"><svg><use href="#i-info"/></svg><span>The project is created <b>not baselined</b> —
      no plan, no cost curve, no schedule performance until a baseline is locked in planning.
      Registration also starts the approval chain: the project is <b>not approved</b> until a
      Project Manager approves it.</span></div>

    <button class="btn pri wide" type="submit"><svg><use href="#i-plus"/></svg>Register project</button>
  </div>
</div>
</form>
<svg style="display:none" aria-hidden="true"><defs>
<symbol id="i-info" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm-2.6 2.4h1.2v12.1H9.5z"/></symbol>
</defs></svg>
