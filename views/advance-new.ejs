<% if (typeof error !== 'undefined') { %>
<div class="errb"><div class="errb-tx"><p><b>Not opened.</b> <%= error %></p></div></div>
<% } %>

<form method="post" action="/advances">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="card" style="max-width:640px">
  <div class="card-hd"><h2>New cash advance</h2><span class="r"><%= projectName %></span></div>
  <div class="fbody">
    <label class="fld">Advance no.
      <input type="text" name="advance_no" value="<%= typeof form !== 'undefined' ? (form.advance_no || '') : '' %>" placeholder="ADV-…"></label>
    <label class="fld">Recipient type
      <select name="recipient_type">
        <option value="">— not set —</option>
        <option value="project_admin" <%= typeof form !== 'undefined' && form.recipient_type === 'project_admin' ? 'selected' : '' %>>Project Admin</option>
        <option value="employee" <%= typeof form !== 'undefined' && form.recipient_type === 'employee' ? 'selected' : '' %>>Employee</option>
        <option value="supplier" <%= typeof form !== 'undefined' && form.recipient_type === 'supplier' ? 'selected' : '' %>>Supplier</option>
      </select></label>
    <label class="fld">Amount <span class="dim">whole rupiah</span>
      <input type="number" name="amount" min="1" step="1" inputmode="numeric" required
             value="<%= typeof form !== 'undefined' && form.amount ? form.amount : '' %>" placeholder="0"></label>
    <label class="fld">Submission date
      <input type="date" name="submission_date" value="<%= typeof form !== 'undefined' && form.submission_date ? form.submission_date : defaultDate %>"></label>
    <label class="fld">Approved date
      <input type="date" name="approved_date" value="<%= typeof form !== 'undefined' && form.approved_date ? form.approved_date : '' %>"></label>
    <label class="fld">Issued date <span class="dim">defaults to approved date</span>
      <input type="date" name="issued_date" value="<%= typeof form !== 'undefined' && form.issued_date ? form.issued_date : '' %>"></label>
    <label class="fld">Description
      <input type="text" name="description" value="<%= typeof form !== 'undefined' ? (form.description || '') : '' %>" placeholder="What the money is for"></label>

    <div class="fnote"><svg><use href="#i-info"/></svg><span>The advance is <b>not cost</b> — it is
      money handed out. Cost appears only when Expense Report detail lines are entered and a
      <b>Cost Controller checks</b> them. Finance's bulk settlement stays out of the cost basis, so
      nothing is counted twice.</span></div>

    <button class="btn pri wide" type="submit"><svg><use href="#i-plus"/></svg>Open cash advance</button>
  </div>
</div>
</form>
<svg style="display:none" aria-hidden="true"><defs>
<symbol id="i-info" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm-2.6 2.4h1.2v12.1H9.5z"/></symbol>
</defs></svg>
